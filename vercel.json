{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": [
        "node_modules/pdf-parse/**",
        "node_modules/@napi-rs/canvas/**",
        "node_modules/pdf-parse/node_modules/@napi-rs/canvas/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?path=:path*" }
  ]
}
