# GROQ_API_KEY: Primary provider for all AI API calls (resume parsing, job matching,
# job comparison, AI-generated application packages). Used server-side only (server.js),
# via callGroqAPI() against https://api.groq.com/openai/v1/chat/completions with model
# llama-3.3-70b-versatile.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Automatic fallback provider — used via callGeminiAPI() (model
# gemini-3.6-flash) whenever a Groq call fails (rate limit, outage, malformed
# response), so a single provider's exhausted free-tier quota doesn't take AI features
# down entirely. At least one of GROQ_API_KEY / GEMINI_API_KEY must be set.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & CORS — comma-separated production origins.
# Loopback http(s) origins (localhost / 127.0.0.1, any port) are always allowed
# so Vite can fall back from :3000 to :3002 when ports are busy.
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"
NODE_ENV="production"

# Database — override to keep the SQLite file outside the web root in production.
# On Vercel this defaults to /tmp/talentai.db (ephemeral).
DB_PATH="./talentai.db"

# Frontend API origin. Leave unset so the browser always calls same-origin /api
# (Vercel functions, or Express serving dist/ on Railway/Render/a VPS).
# Set this only when the SPA and API are on different hosts.
# VITE_API_BASE="https://your-api.example.com/api"
