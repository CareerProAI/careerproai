# GROQ_API_KEY: Primary provider for all AI API calls (resume parsing, job matching,
# job comparison, AI-generated application packages). Used server-side only (server.js),
# via callGroqAPI() against https://api.groq.com/openai/v1/chat/completions with model
# llama-3.3-70b-versatile.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Automatic fallback provider — used via callGeminiAPI() (model
# gemini-3.6-flash) whenever a Groq call fails (rate limit, outage, malformed
# response), so a single provider's exhausted free-tier quota doesn't take AI features
# down entirely. At least one of GROQ_API_KEY / GEMINI_API_KEY must be set.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
